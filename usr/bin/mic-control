#!/bin/bash

MIC_SOURCE=$(pactl list sources short | grep -i 'input' | awk '{print $1}')
MUTE=$(pactl get-source-mute $MIC_SOURCE | grep -oP '(?<=Mute: )\w+')

if [ "$1" = "toggle" ]; then
  pactl set-source-mute "$MIC_SOURCE" toggle
  dunstify "" -u low -t 1500 -i ~/dotfiles/icons/fontawesome/microphone$([ "$MUTE" = "no" ] && echo "-mute").svg -r 100811
  paplay ~/dotfiles/sounds/discord-$([ "$MUTE" = "no" ] && echo "un")mute-mic.ogg --volume 50000
  echo "$MUTE"
  exit 0
fi

if [ "$1" = "status" ]; then
  if [ "$MUTE" = "yes" ]; then
    echo "<fc=#e06c75><fn=0></fn></fc>"
    exit 0
  else
    echo "<fn=0> </fn>"
    exit 0
  fi
fi
