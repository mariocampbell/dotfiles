
Config {
   -- appearance
     font = "Roboto Medium 10"

     , additionalFonts = [
     -- arch logo
     "Bitstream Vera Sans Mono Bold 14"

     -- date
       , "Roboto Bold 11"
     ]
   , bgColor =      "#000000"
   , fgColor =      "#abb2bf"
   , alpha = 100
   , position = TopHM 30 10 10 5 0

   -- layout
   , sepChar =  "%"   -- delineator between plugin names and straight text
   , alignSep = "}{"  -- separator between left-right alignment
   , template = "
   <fn=1><fc=#abb2bf> </fc></fn>
   %StdinReader%
   }
   <action='gnome-calendar'><fc=#ffffff><fn=2>%myDate%</fn></fc></action>
   {
  <action=`volume-control toggle` button=1><action=`pavucontrol` button=2><action=`tilix -e pulsemixer` button=3><action=`volume-control up` button=4><action=`volume-control down` button=5>%volume%</action></action></action></action></action>
  <action='changekeyboard'>%kbd%</action>
  <action=`mic-control toggle` button=1>%mic%</action>
  <action=`flameshot gui` button=1><action=`gnome-screenshot -i` button=3><fn=6>  </fn></action></action>
  <action=`rofi-bluetooth` button=1><action=`blueberry` button=3>%bluetooth%</action></action>
  %multicoretemp%
  %SANT%   "

   -- general behavior
   , lowerOnStart =     True    -- send to bottom of window stack on start
   , hideOnStart =      False   -- start with window unmapped (hidden)
   , allDesktops =      True    -- show on all desktops
   , overrideRedirect = True    -- set the Override Redirect flag (Xlib)
   , pickBroadest =     True   -- choose widest display (multi-monitor)
   , persistent =       True    -- enable/disable hiding (True = disabled)

   -- plugins
   --   Numbers can be automatically colored according to their value. xmobar
   --   decides color based on a three-tier/two-cutoff system, controlled by
   --   command options:
   --     --Low sets the low cutoff
   --     --High sets the high cutoff
   --
   --     --low sets the color below --Low cutoff
   --     --normal sets the color between --Low and --High cutoffs
   --     --High sets the color above --High cutoff
   --
   --   The --template option controls how the plugin is displayed. Text
   --   color can be set by enclosing in <fc></fc> tags. For more details
   --   see http://projects.haskell.org/xmobar/#system-monitor-plugins.
   , commands =

        -- weather monitor
        [ Run Weather "SANT1" [ "--template", "<fn=0></fn> <tempC>°C" ] 36000

        , Run WeatherX "SANT"
             [ ("clear", "")
             , ("sunny", "󰖨")
             , ("mostly clear", "")
             , ("mostly sunny", "")
             , ("partly sunny", "")
             , ("fair", "")
             , ("cloudy","")
             , ("overcast","")
             , ("partly cloudy", "")
             , ("mostly cloudy", "")
             , ("considerable cloudiness", "")]
             ["-t", "<fn=1><skyConditionS></fn>  <tempC>°C"
             , "-L","15", "-H", "29", "--normal", "#abb2bf"
             , "--high", "#d19a66", "--low", "#61aeee"]
             18000

        -- StdinReader
        , Run StdinReader

        -- cpu core temperature monitor
        , Run MultiCoreTemp ["-t", "   <avg>°C  ", "-hwmonitor-path", "/sys/module/k10temp/drivers/pci:k10temp/0000:00:18.3/hwmon/hwmon2"] 50

        -- keyboard control
        , Run Com "keyboard-control.mjs" ["--xmobar"] "keyboard-control" 5

        -- keyboard battery
        , Run Com "keyboard-control.mjs" ["--battery"] "keyboard-battery" 5

        -- battery monitor
        , Run Battery        [ "--template" , "<acstatus>"
                             , "--Low"      , "15"        -- units: %
                             , "--High"     , "80"        -- units: %
                             , "--low"      , "#e06c75"
                             -- , "--normal"   , "#ffffff"
                             -- , "--high"     , "#ffffff"

                             , "--" -- battery specific options
                                       , "-A", "15"
                                       , "-a", "dunstify \"Battery\" \"You must plug in the battery now\" -u critical -i ~/dotfiles/icons/fontawesome/battery-alert.svg"
                                       -- discharging status
                                       , "-o"	, "<fn=4></fn> <left>% (<timeleft>)"
                                       -- AC "on" status
                                       , "-O"	, "<fn=1></fn> <left>%"
                                       -- charged status
                                       , "-i"	, "<fn=1></fn> <left>%"
                             ] 50

        -- time and date indicator
        --   (%F = y-m-d date, %a = day of week, %T = h:m:s time)

        -- Date indicator
        , Run Date "<action='gnome-calendar'><fc=#ffffff><fn=3>%a %d %Y - %H:%M</fn></fc></action>" "date" 50
        , Run Com "date" ["+%A, %d de %b - %H:%M"] "myDate" 50

        -- keyboard layout indicator
        , Run Kbd            [ ("es" , "<fc=#e06c75><fn=6> </fn> ES</fc>")
                             , ("us" , "<fn=6> </fn> US")
                             ]

        -- volume indicator
        , Run Com "volume-control" ["status"] "volume" 5

        -- mic-control indicator
        , Run Com "mic-control" ["status"] "mic" 5

        -- weather indicator
        , Run Com "weather-control" [] "weather" 36000

        -- bluetooth indicator
        , Run Com "bluetooth-control" ["status"] "bluetooth" 5

        -- wireless interface
        , Run Wireless "wlo1" ["-t", "<action='rofi-wifi-menu'><fn=1></fn> <ssid></action>"] 3600

        ]
   }
